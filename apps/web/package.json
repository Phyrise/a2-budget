{
  "name": "@a2/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build && node scripts/check-firebase-split.mjs dist",
    "build:emu": "tsc --noEmit && vite build --mode emulators --outDir dist-emu && node scripts/check-firebase-split.mjs dist-emu --emulators",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e && node scripts/check-firebase-split.mjs dist-e2e --no-config",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "pnpm build:e2e && playwright test",
    "e2e:sync": "pnpm build:emu && playwright test -c playwright.sync.config.ts"
  },
  "dependencies": {
    "@a2/core": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "12.19.0",
    "ogl": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
