{
  "name": "a2-budget",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @a2/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @a2/web build",
    "preview": "pnpm --filter @a2/web preview"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.4",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
